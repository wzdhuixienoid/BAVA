POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://banking:banking@postgres:5432/banking
APP_ENVIRONMENT=development
AUTH_MODE=development
DEVELOPMENT_USER_ID=dev-user-001
# Required when AUTH_MODE=oidc. OIDC_JWKS_URL may be blank to use discovery.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=openai_compatible
# OpenAI-compatible API root only, for example https://example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Optional Mock-only features. No global TTL is extended.
MOCK_SCHEDULED_TRANSFERS_ENABLED=false
# Synthetic subscription mandates only; Docker defaults to enabled for this demo.
MOCK_SUBSCRIPTION_BILLING_ENABLED=true
RECURRING_TRANSFER_MAX_OCCURRENCES=12
RECURRING_TRANSFER_MAX_DAYS=366
SCHEDULED_TRANSFER_MIN_ADVANCE_SECONDS=60
SCHEDULED_TRANSFER_MAX_DAYS=30
SCHEDULED_TRANSFER_LATE_WINDOW_SECONDS=300
SCHEDULED_TRANSFER_LEASE_SECONDS=60
# Development authentication only; generate a private random key >= 32 characters to enable.
MOCK_PARTICIPANT_LOGIN_ENABLED=false
MOCK_PARTICIPANT_SIGNING_KEY=
TRANSFER_APPROVAL_TTL_SECONDS=600
TRANSFER_REAUTH_TTL_SECONDS=300
TRANSFER_REAUTH_MAX_ATTEMPTS=3
SECURITY_REAUTH_FAILURE_LIMIT=3
SECURITY_REAUTH_FAILURE_WINDOW_SECONDS=600
SECURITY_BYPASS_LIMIT=5
SECURITY_BYPASS_WINDOW_SECONDS=300
SECURITY_WRITE_LOCK_SECONDS=900
BANKING_BUSINESS_TIMEZONE=Asia/Shanghai
# Backend-only identity code. Configure the user's value; never return it to the browser.
MOCK_REAUTH_CODE=246810
# mock is development/test only. Production requires totp + OIDC.
REAUTH_PROVIDER=mock
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=
MFA_ISSUER=BAVA
SUBSCRIPTION_READ_CONSENT_SECONDS=300
OPERATION_RECOVERY_ENABLED=true
OPERATION_RECOVERY_POLL_INTERVAL_SECONDS=5
OPERATION_RECOVERY_LEASE_SECONDS=60
OPERATION_RECOVERY_INITIAL_RETRY_SECONDS=5
OPERATION_RECOVERY_MAX_RETRY_SECONDS=300
OPERATION_RECOVERY_BACKOFF_MULTIPLIER=2
OPERATION_RECOVERY_BATCH_SIZE=10
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=0.5
OUTBOX_PUBLISHER_LEASE_SECONDS=30
OUTBOX_PUBLISHER_INITIAL_RETRY_SECONDS=1
OUTBOX_PUBLISHER_MAX_RETRY_SECONDS=60
OUTBOX_PUBLISHER_BACKOFF_MULTIPLIER=2
OUTBOX_PUBLISHER_BATCH_SIZE=20
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL_SECONDS=0.5
TASK_WORKER_LEASE_SECONDS=60
TASK_WORKER_HEARTBEAT_SECONDS=15
TASK_WORKER_INITIAL_RETRY_SECONDS=2
TASK_WORKER_MAX_RETRY_SECONDS=120
TASK_WORKER_BACKOFF_MULTIPLIER=2
TASK_WORKER_BATCH_SIZE=4
TASK_WORKER_MAX_CONCURRENCY=4
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_RUNTIME=langgraph
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE="openid profile"

# Optional development/test synthetic read clock (anomaly/renewal only).
# Production rejects this setting. Risk, TTL, lease and recovery keep real time.
# DEMO_REFERENCE_TIME=2026-09-28T12:00:00Z

# Mock open-ended NAV wealth; forbidden in production
MOCK_WEALTH_ENABLED=true
